NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/researchproof_ai
JWT_SECRET=0eb61ab143f8564b02d81a41c158ba369cc65b53998b707ec7a8455cd717cbf3
GOOGLE_CLIENT_ID=387878022617-624p2r5hfa278npj531373cc8lf64t1e.apps.googleusercontent.com
