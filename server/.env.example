# Configurable production redirect URI (must match Google Cloud Console Authorized redirect URIs exactly)
GOOGLE_REDIRECT_URI=https://research-proof-1.onrender.com/api/auth/google/callback

# Bot Protection (Cloudflare Turnstile - optional, disabled by default)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Session Configuration
SESSION_COOKIE_NAME=researchproof_session
SESSION_TTL_HOURS=24

# Free Usage Limits (Section 6)
FREE_REWRITE_DAILY_LIMIT=5
FREE_REWRITE_MAX_WORDS=2000
FREE_ANALYSIS_DAILY_LIMIT=10
FREE_ANALYSIS_MAX_WORDS=5000

# Research Privacy
PERSIST_DOCUMENT_TEXT=true

# AI Provider Configuration (Optional - Gemini / OpenAI / Groq / OpenRouter / ReverseGPT)
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-1.5-flash

# Phase 2 Academic Tools Settings
MAX_DOCX_UPLOAD_SIZE=10485760
CROSSREF_MAILTO=academic-integrity@researchproof.ai
CITATION_TIMEOUT_MS=8000

# Phase 3 Platform Management Settings
ADMIN_EMAIL=admin@researchproof.ai
ADMIN_PASSWORD=AdminPassword123!
ADMIN_DASHBOARD_ENABLED=true
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
INTEGRITY_REPORTS_ENABLED=true
INTEGRITY_MAX_WORDS=10000
DATA_EXPORT_ENABLED=true
ACCOUNT_DELETION_ENABLED=true

