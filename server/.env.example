NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/researchproof_ai
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session Configuration
SESSION_COOKIE_NAME=researchproof_session
SESSION_TTL_HOURS=24

# Free Usage Limits (Section 6)
FREE_REWRITE_DAILY_LIMIT=5
FREE_REWRITE_MAX_WORDS=2000
FREE_ANALYSIS_DAILY_LIMIT=10
FREE_ANALYSIS_MAX_WORDS=5000

# Research Privacy
PERSIST_DOCUMENT_TEXT=true

# AI Provider Configuration (Optional - Gemini / OpenAI / Groq / OpenRouter / ReverseGPT)
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-1.5-flash

# Phase 2 Academic Tools Settings
MAX_DOCX_UPLOAD_SIZE=10485760
CROSSREF_MAILTO=academic-integrity@researchproof.ai
CITATION_TIMEOUT_MS=8000

